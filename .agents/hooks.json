{
  "guard-git": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node ./hooks/guard-git.cjs", "timeout": 10 }
        ]
      }
    ]
  },
  "session-env": {
    "SessionStart": [
      { "type": "command", "command": "node ./hooks/session-env.cjs", "timeout": 10 }
    ]
  }
}
